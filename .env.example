# ── Google Credentials ────────────────────────────────────────────────────────
# Path to your service account JSON key file (recommended)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# ── GSC Properties ────────────────────────────────────────────────────────────
# Comma-separated list of GSC property URLs to monitor.
# Use the exact format from your GSC dashboard.
# Domain properties: sc-domain:yourdomain.com
# URL-prefix properties: https://www.yourdomain.com/
GSC_PROPERTIES=https://www.example.com/,sc-domain:example2.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./gsc-monitor.db
OUTPUT_DIR=./output

# ── Alert Settings ────────────────────────────────────────────────────────────
# Percentage drop in indexed URLs that triggers a regression alert (default: 5)
ALERT_THRESHOLD=5
# Rolling average window in days for baseline calculation (default: 7)
ALERT_WINDOW=7
# Set to "true" to enable email alerts
ALERT_EMAIL=false
# Set to "false" to disable CSV exports
ALERT_CSV=true

# ── SMTP (required only if ALERT_EMAIL=true) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="GSC Monitor <your-email@gmail.com>"
SMTP_TO=admin@youragency.com

# ── History ───────────────────────────────────────────────────────────────────
# Days of history to fetch when running the report command (default: 28)
LOOKBACK_DAYS=28
