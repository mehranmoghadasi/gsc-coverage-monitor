# Path to a Google service-account JSON key. The service account's email must be
# added as a user (Full or Restricted) on every property in gsc-monitor.json.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional: Slack/Discord/Teams incoming-webhook URL for alerts. Leave empty to
# get console + alerts.csv only.
ALERT_WEBHOOK_URL=

# SQLite file (created on first run)
GSC_MONITOR_DB=./data/gsc-monitor.db
