{
  "name": "gsc-coverage-monitor",
  "version": "1.0.0",
  "description": "Multi-property Google Search Console coverage drift monitor with SQLite history, regression detection, and email/CSV alerts",
  "main": "src/index.js",
  "bin": {
    "gsc-monitor": "src/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "poll": "node src/index.js poll",
    "report": "node src/index.js report",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --forceExit"
  },
  "keywords": [
    "google-search-console",
    "gsc",
    "seo",
    "webmaster-tools",
    "monitoring",
    "coverage",
    "indexing",
    "sqlite",
    "nodejs",
    "agency"
  ],
  "author": "Mehran Moghadasi <mehran.moghadasi@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "fast-csv": "^5.0.1",
    "googleapis": "^140.0.1",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "transform": {},
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
